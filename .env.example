# Clave de la API de Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Identidad del bot
COMPANY_NAME=Senda Consultora
BOT_NAME=Senda

# Modelo y nivel de razonamiento (low | medium | high). "low" es rápido y alcanza para chat;
# subilo a "medium" si querés respuestas de asesoramiento más elaboradas.
BOT_MODEL=claude-opus-5-5
BOT_EFFORT=low
ENABLE_FALLBACKS=true

# Webhook donde se envían los leads (Google Sheets vía Apps Script, Make, Zapier, n8n, CRM...)
# Ver docs/google-sheets-apps-script.gs
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# Dominios donde se va a insertar el widget (separados por coma). Ej: https://senda.com,https://www.senda.com
ALLOWED_ORIGINS=

PORT=3000

# Límites anti-abuso
MAX_MESSAGE_CHARS=2000
MAX_USER_TURNS=40
RATE_LIMIT_MESSAGES=20
RATE_LIMIT_WINDOW_MINUTES=10
